{
  "name": "locatra",
  "version": "1.4.0",
  "private": true,
  "description": "Browser extension that inspects elements for ranked, uniqueness-checked locators and records flows into runnable Playwright / Selenium / Cypress tests.",
  "license": "MIT",
  "author": "Yogesh Bhatt",
  "homepage": "https://github.com/yogesh-bhatttk/Locator_Lens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogesh-bhatttk/Locator_Lens.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:firefox": "npx --yes web-ext@8 lint --source-dir dist/firefox --warnings-as-errors",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:check": "node scripts/version.mjs",
    "build": "node scripts/build.mjs all",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:edge": "node scripts/build.mjs edge",
    "verify": "npm run version:check && npm run format:check && npm run lint && npm run test:coverage && npm run build",
    "prepare": "husky",
    "screenshots": "node scripts/screenshots/capture.mjs",
    "promo": "node scripts/screenshots/promo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pom": "node scripts/e2e/smoke-pom.mjs",
    "smoke:screenshots": "node scripts/e2e/smoke-screenshots.mjs",
    "smoke:settings": "node scripts/e2e/smoke-settings.mjs",
    "smoke:data-health": "node scripts/e2e/smoke-panel-data-health.mjs",
    "smoke:all": "npm run smoke && npm run smoke:pom && npm run smoke:screenshots && npm run smoke:settings && npm run smoke:data-health",
    "test:exports": "node scripts/e2e/run-exports.mjs",
    "test:exports:setup-python": "python3 -m pip install --target node_modules/.cache/locatra-e2e/pylib -r tests/e2e/requirements.txt",
    "test:exports:setup-java": "node scripts/e2e/setup-java.mjs",
    "test:exports:setup-csharp": "node scripts/e2e/setup-csharp.mjs",
    "test:exports:setup-webdriverio": "node scripts/e2e/setup-webdriverio.mjs",
    "test:exports:setup-cypress": "npm install --no-save cypress@15.21.1 cypress-real-events@1.15.1 typescript@5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "playwright": "1.59.1",
    "prettier": "^3.6.2",
    "selenium-webdriver": "4.50.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "prettier --write --ignore-unknown",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,md}": "prettier --write --ignore-unknown"
  }
}
